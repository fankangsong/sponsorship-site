<section class="hero">
  <h1><%= site.title %></h1>
  <p class="intro"><%= site.intro %></p>
</section>

<section>
  <h2>字帖橱窗</h2>
  <div class="grid">
    <% galleryLatest.forEach(function (item) { %>
    <a class="card" href="/gallery/<%= item.id %>/">
      <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy">
      <div class="card-body">
        <h3><%= item.title %></h3>
        <time><%= item.date %></time>
      </div>
    </a>
    <% }) %>
  </div>
  <p class="more"><a href="/gallery/">查看全部字帖 →</a></p>
</section>

<section>
  <h2>随笔</h2>
  <ul class="post-list">
    <% postsLatest.forEach(function (p) { %>
    <li>
      <time><%= p.date %></time>
      <a href="/posts/<%= p.slug %>/"><%= p.title %></a>
      <% if (p.summary) { %><span class="summary"><%= p.summary %></span><% } %>
    </li>
    <% }) %>
  </ul>
  <p class="more"><a href="/posts/">更多随笔 →</a></p>
</section>

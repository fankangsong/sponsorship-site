<h1>字帖橱窗</h1>
<div class="grid">
  <% gallery.forEach(function (item) { %>
  <a class="card" href="/gallery/<%= item.id %>/">
    <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy">
    <div class="card-body">
      <h3><%= item.title %></h3>
      <time><%= item.date %></time>
    </div>
  </a>
  <% }) %>
</div>
